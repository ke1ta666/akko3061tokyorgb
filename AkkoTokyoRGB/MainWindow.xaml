<Window x:Class="AkkoTokyoRGB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:AkkoTokyoRGB.Controls"
        Title="AKKO 3061 • World Tour Tokyo RGB"
        Icon="pack://application:,,,/Assets/tokyo_icon.ico"
        Width="1180" Height="900"
        MinWidth="1020" MinHeight="800"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        Background="{DynamicResource SakuraBgBrush}">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="38"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="10"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource SakuraCardBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SakuraBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="15"/>
        </Style>

        <Style x:Key="ChromeBtn" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TokyoMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#2A1D31"/>
                                <Setter Property="Foreground" Value="#FCEFF4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChromeCloseBtn" TargetType="Button" BasedOn="{StaticResource ChromeBtn}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="#EE3E6E"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PrimaryBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource ToriiRedBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ToriiRedHoverBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SoftPinkBtn" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource SoftBtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TokyoTextBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="11,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="{DynamicResource SoftBtnBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="#FF8CB0"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bg" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModeCardBtn" TargetType="ToggleButton">
            <Setter Property="Background" Value="{DynamicResource ModeBtnBgBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TokyoTextBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ModeBtnBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10" Padding="11,8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#D66289"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#FF6996"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="RootWindowFrame" BorderBrush="{DynamicResource SakuraBorderBrush}" BorderThickness="1" Background="{DynamicResource SakuraBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- CUSTOM WORLD TOUR TOKYO TITLE BAR (Replaces default white Windows bar) -->
            <Border Grid.Row="0" Background="{DynamicResource TitleBarBgBrush}" BorderBrush="{DynamicResource SakuraBorderBrush}" BorderThickness="0,0,0,1">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0" DockPanel.Dock="Left">
                        <Image Source="pack://application:,,,/Assets/tokyo_icon.ico" Width="20" Height="20" Margin="0,0,9,0" RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="AKKO 3061 • World Tour Tokyo RGB" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TokyoTextBrush}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right">
                        <Button x:Name="MinBtn" Content="─" Style="{StaticResource ChromeBtn}" Click="MinBtn_Click" ToolTip="Свернуть"/>
                        <Button x:Name="MaxBtn" Content="□" Style="{StaticResource ChromeBtn}" Click="MaxBtn_Click" ToolTip="Развернуть"/>
                        <Button x:Name="CloseBtn" Content="✕" Style="{StaticResource ChromeCloseBtn}" Click="CloseBtn_Click" ToolTip="Свернуть в трей"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- MAIN CONTENT -->
            <Grid Grid.Row="1" Margin="16,12,16,14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- HEADER BANNER: BLACK & SAKURA PINK -->
                <Border Grid.Row="0" CornerRadius="14" Padding="16,11" Margin="0,0,0,12" BorderBrush="{DynamicResource SakuraBorderBrush}" BorderThickness="1" ClipToBounds="True">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#16101C" Offset="0"/>
                            <GradientStop Color="#281424" Offset="0.55"/>
                            <GradientStop Color="#120E18" Offset="1"/>
                        </LinearGradientBrush>
                    </Border.Background>
                    <Grid>
                        <Canvas Width="260" Height="56" HorizontalAlignment="Center" VerticalAlignment="Bottom" Opacity="0.32" IsHitTestVisible="False">
                            <Ellipse Canvas.Left="118" Canvas.Top="4" Width="26" Height="26" Fill="#FF4D7D"/>
                            <Polygon Points="55,56 128,15 146,15 218,56" Fill="#364F7C"/>
                            <Polygon Points="110,25 128,15 146,15 164,25 150,29 138,22 125,28" Fill="#FFFFFF"/>
                            <Rectangle Canvas.Left="210" Canvas.Top="30" Width="34" Height="4" Fill="#FF4D7D"/>
                            <Rectangle Canvas.Left="214" Canvas.Top="37" Width="26" Height="3" Fill="#FF4D7D"/>
                            <Rectangle Canvas.Left="217" Canvas.Top="32" Width="3" Height="24" Fill="#FF4D7D"/>
                            <Rectangle Canvas.Left="234" Canvas.Top="32" Width="3" Height="24" Fill="#FF4D7D"/>
                        </Canvas>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Width="40" Height="40" CornerRadius="10" Background="#FF6996" BorderBrush="#FFB4CB" BorderThickness="1" Margin="0,0,12,0">
                                    <TextBlock Text="桜" FontSize="21" FontWeight="Bold" Foreground="#180D14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="AKKO 3061 • World Tour Tokyo" FontSize="18.5" FontWeight="Bold" Foreground="#FCEFF4"/>
                                    <TextBlock x:Name="HeaderSubtitleText" Text="Подсветка и эффекты для клавиатуры" FontSize="11.5" Foreground="#D49FB2"/>
                                </StackPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#0E0B13" BorderBrush="#5E2D43" BorderThickness="1" CornerRadius="8" Padding="10,6" Margin="0,0,8,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="#36C775" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="StatusText" Text="Подключено" FontSize="12" FontWeight="SemiBold" Foreground="#FCEFF4"/>
                                    </StackPanel>
                                </Border>
                                <Button x:Name="LangToggleBtn" Content="EN" Style="{StaticResource SoftPinkBtn}" Click="LangToggleBtn_Click" Margin="0,0,8,0" ToolTip="Switch language / Сменить язык"/>
                                <Button x:Name="ThemeToggleBtn" Content="Светлая тема" Style="{StaticResource SoftPinkBtn}" Click="ThemeToggleBtn_Click" Margin="0,0,8,0"/>
                                <Button x:Name="ReconnectBtn" Content="Обновить" Style="{StaticResource SoftPinkBtn}" Click="ReconnectBtn_Click" Margin="0,0,8,0"/>
                                <Button x:Name="RestoreBtn" Content="Вернуть исходный" Style="{StaticResource SoftPinkBtn}" Click="RestoreBtn_Click" ToolTip="Вернуть настройки, которые были на клавиатуре при запуске"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- KEYBOARD 2D STAGE (Smooth Anti-Aliased Vector Geometry) -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Padding="14,12" Margin="0,0,0,12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Margin="0,0,0,10">
                            <TextBlock x:Name="PreviewTitleText" Text="Предпросмотр клавиатуры" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource SakuraPinkAccentBrush}" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="ActiveStateSummary" Text="Режим: —" FontSize="12" Foreground="{DynamicResource TokyoMutedBrush}" HorizontalAlignment="Right"/>
                        </DockPanel>

                        <!-- Anti-aliasing enabled (SnapsToDevicePixels=False, UseLayoutRounding=False) so rounded keycap & case corners are silky smooth! -->
                        <Border Grid.Row="1" SnapsToDevicePixels="False" UseLayoutRounding="False"
                                Background="#09070C" BorderBrush="#341E2B" BorderThickness="1" CornerRadius="14" Padding="14,12" HorizontalAlignment="Center">
                            <Border CornerRadius="12" Padding="9" BorderThickness="2" BorderBrush="#CC6280">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#F8A3B8" Offset="0"/>
                                        <GradientStop Color="#E87D99" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border Background="#0B0810" BorderBrush="#26182D" BorderThickness="1.5" CornerRadius="8" Padding="6">
                                    <StackPanel x:Name="KeyboardPreviewHost" SnapsToDevicePixels="False" UseLayoutRounding="False"/>
                                </Border>
                            </Border>
                        </Border>

                        <!-- PER-KEY CUSTOM TOOLBAR (visible only in 0x14 Custom mode) -->
                        <StackPanel x:Name="PerKeyToolbar" Grid.Row="2" Visibility="Collapsed" Margin="0,10,0,0" HorizontalAlignment="Center">
                            <Border Background="{DynamicResource SakuraPanelBrush}" BorderBrush="{DynamicResource SakuraBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="10,7">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock x:Name="SlotLabelText" Text="Слот:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TokyoMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <StackPanel x:Name="CustomSlotButtonsPanel" Orientation="Horizontal" Margin="0,0,12,0"/>

                                    <TextBlock x:Name="ToolLabelText" Text="Инструмент:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TokyoMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ToggleButton x:Name="BrushToolBtn" Content="Кисть" IsChecked="True" Padding="10,4" Margin="0,0,5,0" FontSize="11.5" Click="PerKeyToolBtn_Click">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Background" Value="{DynamicResource SoftBtnBgBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TokyoTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SoftBtnBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource ToriiRedBrush}"/>
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="#FF8CB0"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <ToggleButton x:Name="EraserToolBtn" Content="Ластик" Padding="10,4" Margin="0,0,5,0" FontSize="11.5" Click="PerKeyToolBtn_Click">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                                                <Setter Property="Background" Value="{DynamicResource SoftBtnBgBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TokyoTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SoftBtnBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource ToriiRedBrush}"/>
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="#FF8CB0"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                    <Button x:Name="FillAllBtn" Content="Залить всё" Style="{StaticResource SoftPinkBtn}" Padding="10,4" FontSize="11.5" Margin="0,0,12,0" Click="PerKeyFillAllBtn_Click"/>

                                    <TextBlock x:Name="PresetLabelText" Text="Пресет:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TokyoMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <Button Content="Tokyo" Style="{StaticResource SoftPinkBtn}" Padding="9,4" FontSize="11.5" Margin="0,0,4,0" Click="PerKeyPresetTokyo_Click"/>
                                    <Button Content="WASD" Style="{StaticResource SoftPinkBtn}" Padding="9,4" FontSize="11.5" Margin="0,0,4,0" Click="PerKeyPresetWasd_Click"/>
                                    <Button x:Name="RainbowPresetBtn" Content="Радуга" Style="{StaticResource SoftPinkBtn}" Padding="9,4" FontSize="11.5" Margin="0,0,4,0" Click="PerKeyPresetRainbow_Click"/>
                                    <Button x:Name="ClearPerKeyBtn" Content="Очистить" Style="{StaticResource SoftPinkBtn}" Padding="9,4" FontSize="11.5" Margin="0,0,12,0" Click="PerKeyClearBtn_Click"/>

                                    <ToggleButton x:Name="CalibrateToggleBtn" Content="Калибровка" Padding="10,4" FontSize="11.5" Click="CalibrateToggleBtn_Click" ToolTip="Если какая-то клавиша на клавиатуре не совпадает со схемой, нажмите для быстрой привязки">
                                        <ToggleButton.Style>
                                            <Style TargetType="ToggleButton">
                                                <Setter Property="Background" Value="{DynamicResource SoftBtnBgBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource TokyoTextBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource SoftBtnBorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Setter Property="Cursor" Value="Hand"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ToggleButton">
                                                            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsChecked" Value="True">
                                                                    <Setter TargetName="b" Property="Background" Value="{DynamicResource ToriiRedBrush}"/>
                                                                    <Setter TargetName="b" Property="BorderBrush" Value="#FF8CB0"/>
                                                                    <Setter Property="Foreground" Value="White"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ToggleButton.Style>
                                    </ToggleButton>
                                </WrapPanel>
                            </Border>

                            <!-- Calibration Strip -->
                            <Border x:Name="CalibrationBar" Visibility="Collapsed" Margin="0,6,0,0" Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource SakuraPinkAccentBrush}" BorderThickness="1" CornerRadius="8" Padding="10,5">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock x:Name="CalibTitleText" Text="Калибровка LED:" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SakuraPinkAccentBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <Button Content="◀" Style="{StaticResource SoftPinkBtn}" Padding="8,2" Click="CalibPrevSlot_Click"/>
                                    <TextBlock x:Name="CalibSlotText" Text="Слот 0 / 84" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TokyoTextBrush}" VerticalAlignment="Center" Margin="10,0"/>
                                    <Button Content="▶" Style="{StaticResource SoftPinkBtn}" Padding="8,2" Margin="0,0,12,0" Click="CalibNextSlot_Click"/>
                                    <TextBlock x:Name="CalibHintText" Text="Кликните по загоревшейся клавише на схеме выше (привяжется к слоту)" FontSize="11.5" Foreground="{DynamicResource TokyoMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button x:Name="CalibResetBtn" Content="Сброс карты" Style="{StaticResource SoftPinkBtn}" Padding="8,2" FontSize="11" Click="CalibResetMap_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- MAIN WORKSPACE: LEFT = 18 MODES, RIGHT = COLOR WHEEL & PARAMETERS -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="1.05*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: MODES -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Margin="0,0,0,10">
                                <TextBlock x:Name="ModesHeaderText" Text="Режимы подсветки (19 эффектов)" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TokyoTextBrush}"/>
                                <TextBlock x:Name="ModesSubHeaderText" Text="Клик сразу включает эффект" FontSize="11.5" Foreground="{DynamicResource TokyoMutedBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
                            </DockPanel>

                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <UniformGrid x:Name="ModesGrid" Columns="2"/>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <!-- RIGHT: CIRCULAR 16.7M COLOR WHEEL + PARAMETERS -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
                                <StackPanel>
                                    <TextBlock x:Name="ColorParamsHeaderText" Text="Цвет и параметры эффекта" FontSize="14.5" FontWeight="Bold" Foreground="{DynamicResource TokyoTextBrush}" Margin="0,0,0,10"/>

                                    <!-- Color Picker Panel -->
                                    <Border x:Name="ColorPanel" Background="{DynamicResource SakuraPanelBrush}" BorderBrush="{DynamicResource SakuraBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock x:Name="PaletteTitleText" Text="Палитра (16.7 млн цветов)" FontWeight="SemiBold" Foreground="{DynamicResource TokyoTextBrush}" VerticalAlignment="Center"/>
                                                <CheckBox x:Name="RandomColorCheck" Content="Случайный (радуга)" HorizontalAlignment="Right"
                                                          Foreground="{DynamicResource TokyoTextBrush}" Checked="ColorOptionChanged" Unchecked="ColorOptionChanged"/>
                                            </DockPanel>

                                            <Grid Margin="0,2,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="12"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="14"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <ctrl:ColorWheel x:Name="WheelPicker" Grid.Column="0" VerticalAlignment="Center"
                                                                 ColorChanged="WheelPicker_ColorChanged"
                                                                 DragCompleted="WheelPicker_DragCompleted"/>

                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ToneLabelText" Text="Тон" FontSize="10.5" Foreground="{DynamicResource TokyoMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                                                    <Slider x:Name="WheelValueSlider" Orientation="Vertical" Height="152" Minimum="0" Maximum="100" Value="100"
                                                            ValueChanged="WheelValueSlider_ValueChanged"
                                                            Thumb.DragCompleted="Slider_DragCompleted"/>
                                                </StackPanel>

                                                <StackPanel Grid.Column="4" VerticalAlignment="Center">
                                                    <DockPanel Margin="0,0,0,8">
                                                        <Border x:Name="ColorPreviewBox" Width="36" Height="28" CornerRadius="7" BorderBrush="#8A4B66" BorderThickness="1" Background="#FF1950" Margin="0,0,8,0"/>
                                                        <TextBox x:Name="HexTextBox" Text="#FF1950" Padding="7,4" VerticalContentAlignment="Center"
                                                                 BorderBrush="{DynamicResource SakuraBorderBrush}" Background="{DynamicResource InputBgBrush}" Foreground="{DynamicResource TokyoTextBrush}" FontFamily="Consolas" FontSize="13"
                                                                 LostFocus="HexTextBox_LostFocus" KeyDown="HexTextBox_KeyDown"/>
                                                    </DockPanel>

                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="R" FontWeight="Bold" Foreground="#FF6B85" VerticalAlignment="Center"/>
                                                        <Slider x:Name="RedSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="255" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="RgbSlider_ValueChanged" Thumb.DragCompleted="Slider_DragCompleted" Margin="4,0"/>
                                                        <TextBlock x:Name="RedValText" Grid.Column="2" Text="255" TextAlignment="Right" Foreground="{DynamicResource TokyoTextBrush}"/>
                                                    </Grid>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="G" FontWeight="Bold" Foreground="#5CE094" VerticalAlignment="Center"/>
                                                        <Slider x:Name="GreenSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="25" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="RgbSlider_ValueChanged" Thumb.DragCompleted="Slider_DragCompleted" Margin="4,0"/>
                                                        <TextBlock x:Name="GreenValText" Grid.Column="2" Text="25" TextAlignment="Right" Foreground="{DynamicResource TokyoTextBrush}"/>
                                                    </Grid>
                                                    <Grid Margin="0,2,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="18"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="32"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="B" FontWeight="Bold" Foreground="#69A7FF" VerticalAlignment="Center"/>
                                                        <Slider x:Name="BlueSlider" Grid.Column="1" Minimum="0" Maximum="255" Value="80" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="RgbSlider_ValueChanged" Thumb.DragCompleted="Slider_DragCompleted" Margin="4,0"/>
                                                        <TextBlock x:Name="BlueValText" Grid.Column="2" Text="80" TextAlignment="Right" Foreground="{DynamicResource TokyoTextBrush}"/>
                                                    </Grid>

                                                    <WrapPanel x:Name="SwatchesPanel"/>
                                                    <TextBlock x:Name="ColorHintText" Text="" FontSize="11" Foreground="{DynamicResource TokyoMutedBrush}" Margin="0,4,0,0"/>
                                                </StackPanel>
                                            </Grid>

                                            <CheckBox x:Name="LedGammaCheck" Content="Калибровка гаммы 1.65 (приглушить пересвет на белых кейкапах)"
                                                      IsChecked="False" FontSize="11" Foreground="{DynamicResource TokyoMutedBrush}"
                                                      Checked="ColorOptionChanged" Unchecked="ColorOptionChanged"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Brightness / Speed / Direction -->
                                    <Border Background="{DynamicResource SakuraPanelBrush}" BorderBrush="{DynamicResource SakuraBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,0,10">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="BrightnessLabelText" Text="Яркость" FontWeight="SemiBold" Foreground="{DynamicResource TokyoTextBrush}" VerticalAlignment="Center"/>
                                                <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="4" Value="3" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="ParamSlider_ValueChanged" Thumb.DragCompleted="Slider_DragCompleted" Margin="6,0"/>
                                                <TextBlock x:Name="BrightnessValText" Grid.Column="2" Text="3 / 4" TextAlignment="Right" Foreground="{DynamicResource TokyoTextBrush}"/>
                                            </Grid>

                                            <Grid x:Name="SpeedRow" Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="95"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="48"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="SpeedLabelText" Text="Скорость" FontWeight="SemiBold" Foreground="{DynamicResource TokyoTextBrush}" VerticalAlignment="Center"/>
                                                <Slider x:Name="SpeedSlider" Grid.Column="1" Minimum="1" Maximum="6" Value="5" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="ParamSlider_ValueChanged" Thumb.DragCompleted="Slider_DragCompleted" Margin="6,0"/>
                                                <TextBlock x:Name="SpeedValText" Grid.Column="2" Text="5 / 6" TextAlignment="Right" Foreground="{DynamicResource TokyoTextBrush}"/>
                                            </Grid>

                                            <DockPanel x:Name="DirectionRow">
                                                <TextBlock x:Name="DirectionLabelText" Text="Направление" Width="95" FontWeight="SemiBold" Foreground="{DynamicResource TokyoTextBrush}" VerticalAlignment="Center"/>
                                                <StackPanel Orientation="Horizontal">
                                                    <RadioButton x:Name="DirLeftRadio" Content="Влево / Вверх" GroupName="Dir" IsChecked="True" Margin="6,0,14,0" Foreground="{DynamicResource TokyoTextBrush}" Checked="DirectionChanged"/>
                                                    <RadioButton x:Name="DirRightRadio" Content="Вправо / Вниз" GroupName="Dir" Foreground="{DynamicResource TokyoTextBrush}" Checked="DirectionChanged"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!-- Action Buttons -->
                            <StackPanel Grid.Row="1" Margin="0,4,0,0">
                                <Button x:Name="ApplyBtn" Content="Применить и сохранить" Style="{StaticResource PrimaryBtn}" Click="ApplyBtn_Click" Margin="0,0,0,8"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="RamPreviewBtn" Grid.Column="0" Content="Быстрый предпросмотр цвета" Style="{StaticResource SoftPinkBtn}" Click="RamPreviewBtn_Click"/>
                                    <Button x:Name="OffBtn" Grid.Column="2" Content="Выкл свет" Style="{StaticResource SoftPinkBtn}" Click="OffBtn_Click"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- FOOTER -->
                <DockPanel Grid.Row="3" Margin="0,10,0,0">
                    <TextBlock x:Name="FooterLogText" Text="Готово к работе." FontSize="12" Foreground="{DynamicResource TokyoMutedBrush}" DockPanel.Dock="Left"/>
                    <TextBlock x:Name="FooterHintText" Text="Клик по клавише на схеме запускает световую волну" FontSize="11.5" Foreground="{DynamicResource TokyoMutedBrush}" HorizontalAlignment="Right"/>
                </DockPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
